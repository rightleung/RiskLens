# FastAPI app settings
APP_NAME=RiskLens
APP_PORT=8000
VERSION=1.1.0

# Optional service-level defaults
# ASSESS_DEFAULT_SOURCE=yfinance
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ASSESS_MAX_CONCURRENCY=8
ASSESS_TICKER_TIMEOUT_SECONDS=20
SYMBOL_SEARCH_TIMEOUT_SECONDS=8
ASSESS_TIMEOUT_SECONDS=25
CACHE_TTL_SECONDS=600
API_REPORT_DIR=/tmp/credit_api_reports
RICH_REPORT_DIR=/tmp/risklens_rich_reports
MVP_REPORT_DIR=/tmp/risklens_mvp_reports
RATIO_REPORT_DIR=../reports

# Optional monitoring settings
SENTRY_DSN=
ENVIRONMENT=development
DEBUG=false
